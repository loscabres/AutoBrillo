@page "/"
@page "/login"
@inject ServicioAutenticacion Autenticacion
@inject NavigationManager Navegacion

@* Esta pantalla recibe Usuario y Contraseña y llama al método Ingresar de Login.razor.cs. *@
<PageTitle>Acceso | AutoBrillo</PageTitle>

<section class="tarjeta-acceso">
    <p class="etiqueta">LAVADO PROFESIONAL</p>
    <h1>Tu auto merece brillar.</h1>
    <p>Ingresa para administrar AutoBrillo.</p>
    <EditForm Model="credenciales" OnValidSubmit="Ingresar">
        @* Activa las reglas de validación definidas en el modelo del formulario. *@
        <DataAnnotationsValidator />
        <ValidationSummary />

        @* @bind mantiene sincronizado este input con credenciales.Nombre. *@
        <label>Usuario <input @bind="credenciales.Nombre" @ref="campoUsuario" autofocus autocomplete="username" /></label>
        <label>Contraseña <input @bind="credenciales.Password" type="password" autocomplete="current-password" /></label>

        @* El mensaje aparece solo cuando LoginAsync devuelve un error. *@
        @if (error is not null) { <p class="error">@error</p> }
        <button class="boton-principal" disabled="@enviando">@(enviando ? "Ingresando..." : "Ingresar")</button>
    </EditForm>
</section>
