@page "/usuarios"
@inject ServicioAutenticacion Autenticacion
@inject ServicioGestion Gestion
@inject ServicioAlertas Alertas
@inject NavigationManager Navegacion

<PageTitle>Usuarios | AutoBrillo</PageTitle>

@if (cargando)
{
    <p>Comprobando tu sesión...</p>
}
else
{
    <section class="panel-abm panel-usuarios">
        <header class="encabezado-abm">
            <div>
                <p class="etiqueta">ADMINISTRACIÓN</p>
                <h1>Usuarios y accesos</h1>
                <p>Creá usuarios y elegí los roles que podrán utilizar dentro del lavadero.</p>
            </div>
            <div class="insignia-acceso" aria-hidden="true">◈</div>
        </header>

        <div class="formulario-usuario">
            <div class="campo-usuario">
                <label for="nombre-usuario">Nombre de usuario</label>
                <input id="nombre-usuario" @bind="edicion.Nombre" placeholder="Ej.: María González" maxlength="100" />
            </div>
            <div class="campo-usuario campo-password">
                <label for="password-usuario">@(edicion.Id_Usuarios == 0 ? "Contraseña" : "Nueva contraseña (opcional)")</label>
                <div class="entrada-con-accion">
                    <input id="password-usuario" @bind="edicion.Password" type="@(mostrarPasswords ? "text" : "password")" placeholder="Mínimo 6 caracteres" />
                    <button type="button" class="alternar-password" @onclick="() => mostrarPasswords = !mostrarPasswords" aria-label="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" title="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" aria-pressed="@mostrarPasswords">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="2.5" />
                            @if (mostrarPasswords) { <path d="M4 4l16 16" /> }
                        </svg>
                        <span class="lector-pantalla">@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")</span>
                    </button>
                </div>
            </div>
            <div class="campo-usuario campo-password">
                <label for="confirmar-password-usuario">Confirmar contraseña</label>
                <div class="entrada-con-accion">
                    <input id="confirmar-password-usuario" @bind="confirmacionPassword" type="@(mostrarPasswords ? "text" : "password")" placeholder="Repetí la contraseña" />
                    <button type="button" class="alternar-password" @onclick="() => mostrarPasswords = !mostrarPasswords" aria-label="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" title="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" aria-pressed="@mostrarPasswords">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="2.5" />
                            @if (mostrarPasswords) { <path d="M4 4l16 16" /> }
                        </svg>
                        <span class="lector-pantalla">@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")</span>
                    </button>
                </div>
            </div>
        </div>

        <section class="acceso-roles" aria-labelledby="titulo-roles">
            <div class="encabezado-roles">
                <div>
                    <p class="etiqueta">ROL Y ACCESO</p>
                    <h2 id="titulo-roles">Elegí los roles del usuario</h2>
                    <p>Marcá uno o más roles según las tareas que realizará.</p>
                </div>
                <span class="contador-roles">@edicion.Id_Roles.Count seleccionado@(edicion.Id_Roles.Count == 1 ? "" : "s")</span>
            </div>
            <div class="grilla-roles">
                @foreach (var rol in roles)
                {
                    var seleccionado = EstaSeleccionado(rol.Id_Roles);
                    <label class="tarjeta-rol @(seleccionado ? "rol-seleccionado" : "")">
                        <input type="checkbox" checked="@seleccionado" @onchange="() => CambiarRol(rol.Id_Roles)" />
                        <span class="marca-rol" aria-hidden="true">@rol.Descripcion[..1].ToUpper()</span>
                        <span class="detalle-rol">
                            <small>ROL</small>
                            <strong>@rol.Descripcion</strong>
                        </span>
                        <span class="estado-rol" aria-hidden="true">✓</span>
                    </label>
                }
            </div>
        </section>

        <div class="acciones-formulario">
            <button @onclick="Guardar">@(edicion.Id_Usuarios == 0 ? "Crear usuario" : "Guardar cambios")</button>
            @if (edicion.Id_Usuarios != 0)
            {
                <button class="secundario" @onclick="Cancelar">Cancelar edición</button>
            }
        </div>

        <div class="tabla-contenedor">
            <table>
                <thead><tr><th>Id</th><th>Usuario</th><th>Roles asignados</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var usuario in usuarios)
                    {
                        <tr><td>@usuario.Id_Usuarios</td><td>@usuario.Nombre</td><td>@string.Join(", ", usuario.Roles)</td><td><button class="secundario" @onclick="() => Editar(usuario)">Editar</button> <button class="peligro" @onclick="() => Eliminar(usuario)">Eliminar</button></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
