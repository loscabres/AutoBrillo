@page "/inicio"
@inject ServicioAutenticacion Autenticacion
@inject NavigationManager Navegacion

<PageTitle>Inicio | AutoBrillo</PageTitle>

@* La vista espera mientras Inicio.razor.cs comprueba el token con la API. *@
@if (cargando)
{
    <p>Comprobando tu sesión...</p>
}
else
{
    @* Este bloque se muestra únicamente cuando la sesión fue validada. *@
    <section class="hero">
        <p class="etiqueta">PANEL PRINCIPAL</p>
        <h1>AutoBrillo listo para trabajar.</h1>
        <p>Gestiona tu lavadero desde un solo lugar.</p>
        <div class="indicador"><strong>●</strong> Sistema operativo</div>
    </section>
}
